<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>false</UseWindowsForms>
    <AssemblyName>DrivePartitionTool</AssemblyName>
    <RootNamespace>Dpt.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- WPF0001: ThemeMode (Fluent) is marked experimental. -->
    <NoWarn>$(NoWarn);WPF0001;MVVMTK0045</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Dpt.Core\Dpt.Core.csproj" />
    <ProjectReference Include="..\Dpt.Data\Dpt.Data.csproj" />
    <ProjectReference Include="..\Dpt.Ipc\Dpt.Ipc.csproj" />
    <ProjectReference Include="..\Dpt.Shell\Dpt.Shell.csproj" />
    <ProjectReference Include="..\Dpt.Storage\Dpt.Storage.csproj" />
    <ProjectReference Include="..\Dpt.Index\Dpt.Index.csproj" />
    <!-- Built alongside the app and copied to .\service so the installer can register it. -->
    <ProjectReference Include="..\Dpt.IndexService\Dpt.IndexService.csproj" ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>

  <Target Name="CopyCatalogService" AfterTargets="Build">
    <ItemGroup>
      <CatalogServiceFiles Include="$(MSBuildThisFileDirectory)..\Dpt.IndexService\bin\$(Configuration)\net10.0-windows\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(CatalogServiceFiles)" DestinationFiles="@(CatalogServiceFiles->'$(OutDir)service\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.13" />
    <PackageReference Include="VirtualizingWrapPanel" Version="2.5.4" />
  </ItemGroup>

</Project>
