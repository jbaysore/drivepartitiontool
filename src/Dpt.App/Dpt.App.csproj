<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>false</UseWindowsForms>
    <AssemblyName>DrivePartitionTool</AssemblyName>
    <RootNamespace>Dpt.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- WPF0001: ThemeMode (Fluent) is marked experimental. -->
    <NoWarn>$(NoWarn);WPF0001;MVVMTK0045</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Dpt.Core\Dpt.Core.csproj" />
    <ProjectReference Include="..\Dpt.Data\Dpt.Data.csproj" />
    <ProjectReference Include="..\Dpt.Ipc\Dpt.Ipc.csproj" />
    <ProjectReference Include="..\Dpt.Shell\Dpt.Shell.csproj" />
    <ProjectReference Include="..\Dpt.Storage\Dpt.Storage.csproj" />
    <ProjectReference Include="..\Dpt.Index\Dpt.Index.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="VirtualizingWrapPanel" Version="2.5.4" />
  </ItemGroup>

</Project>
