<Window x:Class="Dpt.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:Dpt.App.Controls"
        xmlns:vm="clr-namespace:Dpt.App.ViewModels"
        xmlns:v="clr-namespace:Dpt.App.Views"
        xmlns:s="clr-namespace:Dpt.App.Services"
        Title="DrivePartitionTool" Width="1280" Height="820" MinWidth="720" MinHeight="460"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource DptWindow}" Foreground="{DynamicResource DptInk}"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        AutomationProperties.AutomationId="MainWindow">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="38" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:HomePageViewModel}">
            <v:HomeView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:FolderPageViewModel}">
            <v:FolderView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsPageViewModel}">
            <v:SettingsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SearchPageViewModel}">
            <v:SearchView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DrivesPageViewModel}">
            <v:DrivesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:LargestPageViewModel}">
            <v:LargestView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PlaceholderPageViewModel}">
            <v:PlaceholderView />
        </DataTemplate>

        <!-- Browser-style tab -->
        <Style x:Key="TabItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Height="32" MinWidth="92" MaxWidth="220" CornerRadius="7,7,0,0" Padding="10,0,4,0"
                                Background="Transparent" VerticalAlignment="Bottom">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <c:Icon x:Name="Ic" Data="{Binding IconKey, Converter={StaticResource IconKey}}" Size="15" Foreground="{DynamicResource DptMuted}" />
                                <TextBlock x:Name="Tx" Grid.Column="1" Margin="7,0,6,0" Text="{Binding Title}" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" Foreground="{DynamicResource DptMuted}" ToolTip="{Binding AddressText}" />
                                <Button Grid.Column="2" Style="{StaticResource IconButton}" Width="22" Height="22"
                                        Command="{Binding DataContext.CloseTabCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}" ToolTip="Close tab (Ctrl+W)" AutomationProperties.Name="Close tab">
                                    <c:Icon Data="{StaticResource Icon.X}" Size="12" />
                                </Button>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource DptPanelSoft}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource DptWindow}" />
                                <Setter TargetName="Tx" Property="Foreground" Value="{DynamicResource DptInk}" />
                                <Setter TargetName="Ic" Property="Foreground" Value="{DynamicResource DptInk}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="T" Modifiers="Control" Command="{Binding NewTabCommand}" />
        <KeyBinding Key="W" Modifiers="Control" Command="{Binding CloseTabCommand}" />
        <KeyBinding Key="F4" Modifiers="Control" Command="{Binding CloseTabCommand}" />
        <KeyBinding Key="Tab" Modifiers="Control" Command="{Binding NextTabCommand}" />
        <KeyBinding Key="Tab" Modifiers="Control+Shift" Command="{Binding PreviousTabCommand}" />
        <KeyBinding Key="F5" Command="{Binding SelectedTab.RefreshCommand}" />
        <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoCommand}" />
    </Window.InputBindings>

    <Border x:Name="RootBorder" BorderBrush="{DynamicResource DptBorder}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="38" />
                <RowDefinition Height="43" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Grid Grid.Row="0" Background="{DynamicResource DptRail}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                    <c:Icon Data="{StaticResource Icon.HardDrive}" Size="15" />
                    <TextBlock Text="DrivePartitionTool" Margin="8,0,0,0" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Activity pill -->
                <Button Grid.Column="2" Margin="0,0,10,0" WindowChrome.IsHitTestVisibleInChrome="True" Command="{Binding ToggleActivityCommand}"
                        Cursor="Hand" ToolTip="Activity" AutomationProperties.AutomationId="ActivityPill"
                        Visibility="{Binding Activity.Current, Converter={StaticResource NullToCollapsed}}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{DynamicResource DptPanelSoft}" CornerRadius="5" Padding="8,4">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="6" Height="6" Fill="{DynamicResource DptGreen}" VerticalAlignment="Center" />
                                    <TextBlock Margin="7,0,7,0" FontSize="11" Foreground="{DynamicResource DptMuted}" MaxWidth="260" TextTrimming="CharacterEllipsis"
                                               Text="{Binding Activity.Current.Title}" VerticalAlignment="Center" />
                                    <ProgressBar Width="38" Height="3" Style="{StaticResource Meter}" Foreground="{DynamicResource DptGreen}" Background="{DynamicResource DptBorder}"
                                                 Value="{Binding Activity.Current.Progress, Mode=OneWay}" IsIndeterminate="False" VerticalAlignment="Center" />
                                    <TextBlock Margin="7,0,0,0" FontSize="11" Foreground="{DynamicResource DptMuted}" Text="{Binding Activity.Current.ProgressText}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <StackPanel Grid.Column="3" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource WindowButton}" Click="OnMinimize" ToolTip="Minimize" AutomationProperties.Name="Minimize">
                        <c:Icon Data="{StaticResource Icon.Minimize}" Size="13" StrokeWidth="1.5" />
                    </Button>
                    <Button Style="{StaticResource WindowButton}" Click="OnMaximize" ToolTip="Maximize" AutomationProperties.Name="Maximize">
                        <c:Icon x:Name="MaxIcon" Data="{StaticResource Icon.Maximize}" Size="12" StrokeWidth="1.5" />
                    </Button>
                    <Button Style="{StaticResource CloseWindowButton}" Click="OnClose" ToolTip="Close" AutomationProperties.Name="Close">
                        <c:Icon Data="{StaticResource Icon.X}" Size="13" StrokeWidth="1.5" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Tab bar -->
            <Grid Grid.Row="1" Background="{DynamicResource DptRail}">
                <Border BorderBrush="{DynamicResource DptBorder}" BorderThickness="0,0,0,1" />
                <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Bottom">
                    <ListBox x:Name="TabStrip" ItemsSource="{Binding Tabs}" SelectedItem="{Binding SelectedTab}" ItemContainerStyle="{StaticResource TabItemStyle}"
                             Background="Transparent" BorderThickness="0" Padding="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             AutomationProperties.AutomationId="TabStrip"
                             PreviewMouseLeftButtonDown="OnTabMouseDown" PreviewMouseMove="OnTabMouseMove" PreviewMouseUp="OnTabMouseUp" MouseUp="OnTabMiddleClick">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                    </ListBox>
                    <Button Style="{StaticResource IconButton}" Margin="2,0,0,5" Command="{Binding NewTabCommand}" ToolTip="New tab (Ctrl+T)"
                            AutomationProperties.AutomationId="NewTabButton" AutomationProperties.Name="New tab" VerticalAlignment="Bottom">
                        <c:Icon Data="{StaticResource Icon.Plus}" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Browser bar: back/forward/up, address, search -->
            <Border Grid.Row="2" BorderBrush="{DynamicResource DptBorder}" BorderThickness="0,0,0,1" Padding="10,8" DataContext="{Binding SelectedTab}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource IconButton}" Command="{Binding BackCommand}" ToolTip="Back (Alt+Left)" AutomationProperties.AutomationId="BackButton" AutomationProperties.Name="Back">
                            <c:Icon Data="{StaticResource Icon.ArrowLeft}" />
                        </Button>
                        <Button Style="{StaticResource IconButton}" Command="{Binding ForwardCommand}" ToolTip="Forward (Alt+Right)" AutomationProperties.AutomationId="ForwardButton" AutomationProperties.Name="Forward">
                            <c:Icon Data="{StaticResource Icon.ArrowRight}" />
                        </Button>
                        <Button Style="{StaticResource IconButton}" Command="{Binding UpCommand}" ToolTip="Up one level (Alt+Up)" AutomationProperties.AutomationId="UpButton" AutomationProperties.Name="Up">
                            <c:Icon Data="{StaticResource Icon.ArrowUp}" />
                        </Button>
                        <Button Style="{StaticResource IconButton}" Command="{Binding RefreshCommand}" ToolTip="Refresh (F5)" AutomationProperties.Name="Refresh">
                            <c:Icon Data="{StaticResource Icon.Refresh}" Size="15" />
                        </Button>
                    </StackPanel>

                    <!-- Address: breadcrumb, or a text box while editing -->
                    <Border Grid.Column="1" Style="{StaticResource BarBorder}" Margin="8,0" MouseLeftButtonUp="OnAddressClick" Cursor="IBeam">
                        <Grid>
                            <StackPanel Orientation="Horizontal" Visibility="{Binding IsEditingAddress, Converter={StaticResource BoolToCollapsed}}">
                                <c:Icon Data="{Binding IconKey, Converter={StaticResource IconKey}}" Size="15" Foreground="{DynamicResource DptMuted}" Margin="0,0,6,0" />
                                <ItemsControl ItemsSource="{Binding Breadcrumbs}" VerticalAlignment="Center" AutomationProperties.AutomationId="Breadcrumbs">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Style="{StaticResource CommandButton}" Padding="4,0" MinHeight="24" Content="{Binding Label}" FontSize="13"
                                                        Command="{Binding DataContext.OpenBreadcrumbCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding Path}" Cursor="Hand" />
                                                <TextBlock Text="›" Foreground="{DynamicResource DptMuted}" Margin="1,0" VerticalAlignment="Center"
                                                           Visibility="{Binding IsLast, Converter={StaticResource BoolToCollapsed}}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                            <TextBox x:Name="AddressBox" Style="{StaticResource BareTextBox}" Text="{Binding AddressText, UpdateSourceTrigger=PropertyChanged}"
                                     Visibility="{Binding IsEditingAddress, Converter={StaticResource BoolToVisible}}" AutomationProperties.AutomationId="AddressBox"
                                     IsVisibleChanged="OnAddressVisibleChanged" LostKeyboardFocus="OnAddressLostFocus">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding CommitAddressCommand}" />
                                    <KeyBinding Key="Escape" Command="{Binding CancelAddressCommand}" />
                                </TextBox.InputBindings>
                            </TextBox>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource BarBorder}" Width="290" Visibility="{Binding ShowSearchBox, Converter={StaticResource BoolToVisible}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <c:Icon Data="{StaticResource Icon.Search}" Size="15" Foreground="{DynamicResource DptMuted}" />
                            <TextBlock Grid.Column="1" Margin="8,0,0,0" Text="{Binding SearchPlaceholder}" Foreground="{DynamicResource DptMuted}" VerticalAlignment="Center"
                                       IsHitTestVisible="False" TextTrimming="CharacterEllipsis"
                                       Visibility="{Binding Text, ElementName=TabSearchBox, Converter={StaticResource NullToVisible}}" />
                            <TextBox x:Name="TabSearchBox" Grid.Column="1" Margin="8,0,0,0" Style="{StaticResource BareTextBox}"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="TabSearchBox">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                                </TextBox.InputBindings>
                            </TextBox>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- Body -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Width="208" Background="{DynamicResource DptRail}" BorderBrush="{DynamicResource DptBorder}" BorderThickness="0,0,1,0"
                        Visibility="{Binding ShowNavigationPane, Converter={StaticResource BoolToVisible}}">
                    <v:NavigationPane />
                </Border>

                <ContentControl Grid.Column="1" Content="{Binding SelectedTab.Page}" Focusable="False" IsTabStop="False" />

                <!-- Toast -->
                <Border Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,40" Padding="14,8" CornerRadius="7"
                        Background="{DynamicResource DptInk}" Visibility="{Binding Toast, Converter={StaticResource NullToCollapsed}}" IsHitTestVisible="False">
                    <TextBlock Text="{Binding Toast}" Foreground="{DynamicResource DptWindow}" AutomationProperties.AutomationId="Toast" />
                </Border>

                <!-- Activity flyout -->
                <Border Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,10,0" Width="380" MaxHeight="420"
                        Style="{StaticResource Card}" Padding="12"
                        Visibility="{Binding IsActivityOpen, Converter={StaticResource BoolToVisible}}">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.18" />
                    </Border.Effect>
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="24" Height="24" Command="{Binding ToggleActivityCommand}">
                                <c:Icon Data="{StaticResource Icon.X}" Size="12" />
                            </Button>
                            <TextBlock Text="Activity" Style="{StaticResource H2}" VerticalAlignment="Center" />
                        </DockPanel>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Activity.Items}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource DptBorder}" BorderThickness="0,0,0,1" Padding="0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Small}" TextTrimming="CharacterEllipsis" />
                                                    <ProgressBar Style="{StaticResource Meter}" Height="4" Margin="0,5,0,0" Value="{Binding Progress, Mode=OneWay}"
                                                                 Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisible}}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Top"
                                                            Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisible}}">
                                                    <Button Style="{StaticResource IconButton}" Width="24" Height="24" Command="{Binding TogglePauseCommand}" ToolTip="Pause / resume"
                                                            Visibility="{Binding CanPause, Converter={StaticResource BoolToVisible}}">
                                                        <c:Icon Data="{StaticResource Icon.Pause}" Size="12" />
                                                    </Button>
                                                    <Button Style="{StaticResource IconButton}" Width="24" Height="24" Command="{Binding CancelCommand}" ToolTip="Cancel"
                                                            Visibility="{Binding CanCancel, Converter={StaticResource BoolToVisible}}">
                                                        <c:Icon Data="{StaticResource Icon.X}" Size="12" />
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
