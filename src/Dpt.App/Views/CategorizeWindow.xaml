<Window x:Class="Dpt.App.Views.CategorizeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Categories" Width="420" SizeToContent="Height" MaxHeight="620" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource DptWindow}" Foreground="{DynamicResource DptInk}"
        FontFamily="{StaticResource UiFont}" FontSize="13" AutomationProperties.AutomationId="CategorizeWindow">
    <StackPanel Margin="20,18">
        <TextBlock x:Name="Heading" Style="{StaticResource H2}" FontSize="16" Margin="0,0,0,4" />
        <TextBlock Text="Tick the categories these items belong to. Categories group items without moving them." Style="{StaticResource Small}" TextWrapping="Wrap" Margin="0,0,0,12" />
        <ScrollViewer MaxHeight="340" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="List" AutomationProperties.AutomationId="CategoryChecks">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <CheckBox IsChecked="{Binding Checked}" IsThreeState="{Binding Mixed}" Margin="0,3" AutomationProperties.Name="{Binding Name}">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="10" Height="10" Fill="{Binding Color}" Margin="0,0,8,0" />
                                <TextBlock Text="{Binding Name}" />
                            </StackPanel>
                        </CheckBox>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        <DockPanel Margin="0,10,0,0">
            <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="Add" Click="OnAdd" Margin="6,0,0,0" MinWidth="60" />
            <TextBox x:Name="NewName" AutomationProperties.AutomationId="NewCategoryName" />
        </DockPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Style="{StaticResource SecondaryButton}" Content="Cancel" IsCancel="True" Margin="0,0,8,0" />
            <Button Style="{StaticResource PrimaryButton}" Content="Save" IsDefault="True" Click="OnSave" AutomationProperties.AutomationId="SaveCategories" />
        </StackPanel>
    </StackPanel>
</Window>
