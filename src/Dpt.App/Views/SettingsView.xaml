<UserControl x:Class="Dpt.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.AutomationId="SettingsView">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="26,24,26,27" MaxWidth="860" HorizontalAlignment="Left">
            <TextBlock Text="Settings" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,8" TextWrapping="Wrap"
                       Text="Changes save as soon as you make them." />
            <TextBlock Style="{StaticResource Small}" Margin="0,0,0,20">
                <Run Text="Your data is stored in " /><Run Text="{Binding DataFolder, Mode=OneWay}" />
            </TextBlock>

            <ContentControl x:Name="ExtraHost" Margin="0,0,0,16" />

            <ItemsControl ItemsSource="{Binding Sections}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,22">
                            <TextBlock Text="{Binding Name}" Style="{StaticResource H2}" Margin="0,0,0,8" />
                            <Border Style="{StaticResource Card}" Padding="0">
                                <ItemsControl ItemsSource="{Binding Items}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{DynamicResource DptBorder}" BorderThickness="0,0,0,1" Padding="16,12">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Margin="0,0,20,0">
                                                        <TextBlock>
                                                            <Run Text="{Binding Label, Mode=OneWay}" />
                                                        </TextBlock>
                                                        <TextBlock Text="{Binding Description}" Style="{StaticResource Small}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                                        <TextBlock Text="Advanced" Style="{StaticResource Small}" Foreground="{DynamicResource DptAmber}"
                                                                   Visibility="{Binding Advanced, Converter={StaticResource BoolToVisible}}" />
                                                        <TextBlock Text="{Binding Error}" Foreground="{DynamicResource DptRed}" FontSize="11"
                                                                   Visibility="{Binding Error, Converter={StaticResource NullToCollapsed}}" />
                                                    </StackPanel>
                                                    <Grid Grid.Column="1" VerticalAlignment="Center">
                                                        <CheckBox IsChecked="{Binding BoolValue}" Visibility="{Binding IsToggle, Converter={StaticResource BoolToVisible}}"
                                                                  AutomationProperties.Name="{Binding Label}" AutomationProperties.AutomationId="{Binding Key}" />
                                                        <ComboBox ItemsSource="{Binding Choices}" SelectedIndex="{Binding ChoiceIndex}" MinWidth="170"
                                                                  Visibility="{Binding IsChoice, Converter={StaticResource BoolToVisible}}"
                                                                  AutomationProperties.Name="{Binding Label}" AutomationProperties.AutomationId="{Binding Key}" />
                                                        <TextBox Text="{Binding TextValue, UpdateSourceTrigger=LostFocus}" MinWidth="260" MaxWidth="420"
                                                                 Visibility="{Binding IsText, Converter={StaticResource BoolToVisible}}"
                                                                 AutomationProperties.Name="{Binding Label}" AutomationProperties.AutomationId="{Binding Key}" />
                                                    </Grid>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{Binding StatusText}" Style="{StaticResource Small}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
