<UserControl x:Class="Dpt.App.Views.PlaceholderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Dpt.App.Controls">
    <StackPanel Margin="26,24" >
        <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}" />
        <TextBlock Text="{Binding Message}" Style="{StaticResource Muted}" TextWrapping="Wrap" />
    </StackPanel>
</UserControl>
