<UserControl x:Class="Dpt.App.Views.FolderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Dpt.App.Controls"
             xmlns:vm="clr-namespace:Dpt.App.ViewModels"
             xmlns:wp="clr-namespace:WpfToolkit.Controls;assembly=VirtualizingWrapPanel"
             AutomationProperties.AutomationId="FolderView">
    <UserControl.Resources>
        <DataTemplate x:Key="NameCell" DataType="{x:Type vm:FileItemViewModel}">
            <Grid MinWidth="170">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="22" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Image Source="{Binding Icon}" Width="16" Height="16" VerticalAlignment="Center" Opacity="{Binding RowOpacity}" />
                <TextBlock Grid.Column="1" Margin="7,0,0,0" Text="{Binding DisplayName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           Opacity="{Binding RowOpacity}" Visibility="{Binding IsEditing, Converter={StaticResource BoolToCollapsed}}" />
                <TextBox Grid.Column="1" Margin="3,0,0,0" Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Padding="3,1"
                         MinHeight="24" Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisible}}"
                         IsVisibleChanged="OnRenameBoxVisible" PreviewKeyDown="OnRenameKey" LostKeyboardFocus="OnRenameLostFocus"
                         AutomationProperties.AutomationId="RenameBox" />
            </Grid>
        </DataTemplate>

        <Style x:Key="RowStyle" TargetType="ListViewItem" BasedOn="{StaticResource GridRowStyle}">
            <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
            <Setter Property="ToolTipService.InitialShowDelay" Value="900" />
            <EventSetter Event="MouseDoubleClick" Handler="OnRowDoubleClick" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCut}" Value="True">
                    <Setter Property="Opacity" Value="0.55" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TileStyle" TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
            <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="Margin" Value="3" />
            <EventSetter Event="MouseDoubleClick" Handler="OnRowDoubleClick" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border BorderBrush="{DynamicResource DptBorder}" BorderThickness="0,0,0,1" Padding="10,6" MinHeight="43">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Style="{StaticResource CommandButton}" Command="{Binding PinCommand}" ToolTip="Pin to Home and the navigation pane" AutomationProperties.AutomationId="PinButton">
                        <StackPanel Orientation="Horizontal">
                            <c:Icon Data="{StaticResource Icon.Pin}" Size="15" />
                            <TextBlock Text="Pin" Margin="6,0,0,0" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource CommandButton}" Command="{Binding ToggleViewModeCommand}" ToolTip="Switch between details and thumbnails" AutomationProperties.AutomationId="ViewModeButton">
                        <StackPanel Orientation="Horizontal">
                            <c:Icon x:Name="ViewIcon" Data="{StaticResource Icon.Grid}" Size="15" />
                            <TextBlock x:Name="ViewText" Text="Thumbnails" Margin="6,0,0,0" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource CommandButton}" Click="OnMoreClick" ToolTip="More" AutomationProperties.Name="More">
                        <c:Icon Data="{StaticResource Icon.MoreH}" Size="16" StrokeWidth="3" />
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Copy path" InputGestureText="Ctrl+Shift+C" Command="{Binding CopyPathCommand}" />
                                <MenuItem Header="Properties" InputGestureText="Alt+Enter" Command="{Binding PropertiesCommand}" />
                                <Separator />
                                <MenuItem Header="Open in File Explorer" Command="{Binding OpenInExplorerCommand}" />
                                <MenuItem Header="Open in Terminal" Command="{Binding OpenTerminalCommand}" />
                                <Separator />
                                <MenuItem Header="Delete permanently…" InputGestureText="Shift+Del" Command="{Binding PermanentDeleteCommand}" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource AccentCommandButton}" Command="{Binding NewFolderCommand}" ToolTip="New folder (Ctrl+Shift+N)" AutomationProperties.AutomationId="NewFolderButton">
                        <StackPanel Orientation="Horizontal">
                            <c:Icon Data="{StaticResource Icon.FolderPlus}" Size="15" />
                            <TextBlock Text="New folder" Margin="7,0,0,0" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource CommandButton}" Command="{Binding NewFileCommand}" ToolTip="New text file" AutomationProperties.AutomationId="NewFileButton">
                        <StackPanel Orientation="Horizontal">
                            <c:Icon Data="{StaticResource Icon.FilePlus}" Size="15" />
                            <TextBlock Text="New file" Margin="7,0,0,0" />
                        </StackPanel>
                    </Button>
                    <Rectangle Width="1" Height="18" Fill="{DynamicResource DptBorder}" Margin="6,0" />
                    <Button Style="{StaticResource CommandButton}" Command="{Binding CutCommand}" ToolTip="Cut (Ctrl+X)" AutomationProperties.AutomationId="CutButton">
                        <StackPanel Orientation="Horizontal">
                            <c:Icon Data="{StaticResource Icon.Scissors}" Size="15" />
                            <TextBlock Text="Cut" Margin="7,0,0,0" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource CommandButton}" Command="{Binding CopyCommand}" ToolTip="Copy (Ctrl+C)" AutomationProperties.AutomationId="CopyButton">
                        <StackPanel Orientation="Horizontal">
                            <c:Icon Data="{StaticResource Icon.Copy}" Size="15" />
                            <TextBlock Text="Copy" Margin="7,0,0,0" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource CommandButton}" Command="{Binding PasteCommand}" ToolTip="Paste (Ctrl+V)" AutomationProperties.AutomationId="PasteButton">
                        <StackPanel Orientation="Horizontal">
                            <c:Icon Data="{StaticResource Icon.Paste}" Size="15" />
                            <TextBlock Text="Paste" Margin="7,0,0,0" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource CommandButton}" Click="OnMoveToClick" ToolTip="Move selected items to another folder" AutomationProperties.AutomationId="MoveToButton">
                        <StackPanel Orientation="Horizontal">
                            <c:Icon Data="{StaticResource Icon.FolderInput}" Size="15" />
                            <TextBlock Text="Move to…" Margin="7,0,0,0" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource CommandButton}" Click="OnCopyToClick" ToolTip="Copy selected items to another folder" AutomationProperties.AutomationId="CopyToButton">
                        <StackPanel Orientation="Horizontal">
                            <c:Icon Data="{StaticResource Icon.Clone}" Size="15" />
                            <TextBlock Text="Copy to…" Margin="7,0,0,0" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource CommandButton}" Command="{Binding RenameCommand}" ToolTip="Rename (F2)" AutomationProperties.AutomationId="RenameButton">
                        <StackPanel Orientation="Horizontal">
                            <c:Icon Data="{StaticResource Icon.Pencil}" Size="15" />
                            <TextBlock Text="Rename" Margin="7,0,0,0" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource DangerCommandButton}" Command="{Binding RecycleCommand}" ToolTip="Move to Recycle Bin (Del)" AutomationProperties.AutomationId="RecycleButton">
                        <StackPanel Orientation="Horizontal">
                            <c:Icon Data="{StaticResource Icon.Trash}" Size="15" />
                            <TextBlock Text="Recycle" Margin="7,0,0,0" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Margin="18,14,18,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Margin="0,0,0,10">
                <TextBlock Text="{Binding Heading}" FontSize="20" FontWeight="SemiBold" AutomationProperties.AutomationId="FolderHeading" />
                <TextBlock Text="{Binding FolderPath}" Style="{StaticResource Muted}" FontSize="12" Margin="0,3,0,0" />
            </StackPanel>

            <!-- Details -->
            <ListView x:Name="List" Grid.Row="1" ItemsSource="{Binding Items}" SelectionMode="Extended" ItemContainerStyle="{StaticResource RowStyle}"
                      VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Item"
                      ScrollViewer.IsDeferredScrollingEnabled="False" IsTextSearchEnabled="True" TextSearch.TextPath="Name"
                      Visibility="{Binding IsDetails, Converter={StaticResource BoolToVisible}}" AllowDrop="True" BorderThickness="0" Background="Transparent"
                      SelectionChanged="OnSelectionChanged" PreviewKeyDown="OnListKeyDown" MouseRightButtonUp="OnListRightClick"
                      PreviewMouseLeftButtonDown="OnListMouseDown" PreviewMouseMove="OnListMouseMove" MouseUp="OnListMiddleClick"
                      DragOver="OnDragOver" Drop="OnDrop" GridViewColumnHeader.Click="OnHeaderClick"
                      AutomationProperties.AutomationId="FileList">
                <ListView.View>
                    <GridView AllowsColumnReorder="True">
                        <GridViewColumn x:Name="NameColumn" Header="Name" Width="380" CellTemplate="{StaticResource NameCell}" />
                        <GridViewColumn x:Name="ModifiedColumn" Header="Date modified" Width="160" DisplayMemberBinding="{Binding ModifiedText}" />
                        <GridViewColumn x:Name="TypeColumn" Header="Type" Width="170" DisplayMemberBinding="{Binding TypeName}" />
                        <GridViewColumn x:Name="SizeColumn" Header="Size" Width="110">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding SizeText}" HorizontalAlignment="Right" TextAlignment="Right" MinWidth="90" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>

            <!-- Thumbnails -->
            <ListBox x:Name="Tiles" Grid.Row="1" ItemsSource="{Binding Items}" SelectionMode="Extended" ItemContainerStyle="{StaticResource TileStyle}"
                     Visibility="{Binding IsThumbnails, Converter={StaticResource BoolToVisible}}" AllowDrop="True" BorderThickness="0" Background="Transparent"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                     IsTextSearchEnabled="True" TextSearch.TextPath="Name"
                     SelectionChanged="OnSelectionChanged" PreviewKeyDown="OnListKeyDown" MouseRightButtonUp="OnListRightClick"
                     PreviewMouseLeftButtonDown="OnListMouseDown" PreviewMouseMove="OnListMouseMove" MouseUp="OnListMiddleClick"
                     DragOver="OnDragOver" Drop="OnDrop" AutomationProperties.AutomationId="TileList">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <wp:VirtualizingWrapPanel ItemSize="150,170" SpacingMode="Uniform" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Width="134">
                            <Border Height="120" CornerRadius="6" Background="{DynamicResource DptPanelSoft}">
                                <Grid>
                                    <Image Source="{Binding Icon}" Width="32" Height="32" />
                                    <Image Source="{Binding Thumbnail}" Stretch="Uniform" Margin="4" />
                                </Grid>
                            </Border>
                            <TextBlock Text="{Binding DisplayName}" Margin="0,6,0,0" TextAlignment="Center" TextTrimming="CharacterEllipsis" MaxHeight="36" TextWrapping="Wrap"
                                       Visibility="{Binding IsEditing, Converter={StaticResource BoolToCollapsed}}" />
                            <TextBox Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0" Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisible}}"
                                     IsVisibleChanged="OnRenameBoxVisible" PreviewKeyDown="OnRenameKey" LostKeyboardFocus="OnRenameLostFocus" />
                            <TextBlock Text="{Binding SizeText}" Style="{StaticResource Small}" TextAlignment="Center" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Empty / loading / error -->
            <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                        Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisible}}">
                <TextBlock Text="This folder is empty." Style="{StaticResource Muted}" HorizontalAlignment="Center" />
            </StackPanel>
            <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{Binding ErrorMessage, Converter={StaticResource NullToCollapsed}}">
                <c:Icon Data="{StaticResource Icon.Alert}" Size="28" Foreground="{DynamicResource DptMuted}" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource Muted}" Margin="0,8,0,0" HorizontalAlignment="Center" AutomationProperties.AutomationId="FolderError" />
            </StackPanel>
            <TextBlock Grid.Row="1" Text="Loading…" Style="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisible}}" />

            <DockPanel Grid.Row="2" Margin="0,10,0,0">
                <TextBlock DockPanel.Dock="Right" Text="Folder sizes include nested contents" Style="{StaticResource Small}" />
                <TextBlock Text="{Binding StatusText}" Style="{StaticResource Small}" AutomationProperties.AutomationId="FolderStatus" />
            </DockPanel>
        </Grid>
    </Grid>
</UserControl>
