<Window x:Class="Dpt.App.Views.CloneWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:Dpt.App.Controls"
        Title="Clone a drive" Width="760" SizeToContent="Height" MaxHeight="900" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource DptWindow}" Foreground="{DynamicResource DptInk}"
        FontFamily="{StaticResource UiFont}" FontSize="13" AutomationProperties.AutomationId="CloneWindow">
    <Window.Resources>
        <DataTemplate x:Key="Bar">
            <Border Height="26" CornerRadius="6" ClipToBounds="True" Background="{DynamicResource DptPanelSoft}">
                <ItemsControl ItemsSource="{Binding}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <c:ProportionalPanel MinItemWidth="20" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="c:ProportionalPanel.Weight" Value="{Binding Weight}" />
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{Binding BrushKey, Converter={StaticResource BrushKey}}" BorderBrush="{DynamicResource DptWindow}" BorderThickness="0,0,2,0" ToolTip="{Binding Detail}" Opacity="0.85">
                                <TextBlock Text="{Binding Label}" Foreground="White" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="5,0" />
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </DataTemplate>
    </Window.Resources>
    <StackPanel Margin="22,18">
        <TextBlock Text="Clone a whole drive" Style="{StaticResource H2}" FontSize="17" />
        <TextBlock Text="{Binding Explanation}" TextWrapping="Wrap" Margin="0,6,0,14" />

        <TextBlock Text="Copy from" FontWeight="SemiBold" />
        <ComboBox ItemsSource="{Binding Disks}" SelectedItem="{Binding Source}" DisplayMemberPath="Label" Margin="0,4,0,4" AutomationProperties.AutomationId="CloneSource" />
        <ContentControl Content="{Binding Source.Bar}" ContentTemplate="{StaticResource Bar}" />
        <TextBlock Text="{Binding Source.Contents}" Style="{StaticResource Small}" Margin="0,4,0,12" TextWrapping="Wrap" />

        <TextBlock Text="Copy to" FontWeight="SemiBold" />
        <ComboBox ItemsSource="{Binding Destinations}" SelectedItem="{Binding Destination}" DisplayMemberPath="Label" Margin="0,4,0,4" AutomationProperties.AutomationId="CloneDestination" />
        <ContentControl Content="{Binding Destination.Bar}" ContentTemplate="{StaticResource Bar}" />
        <TextBlock Text="{Binding DestinationWarning}" Foreground="{DynamicResource DptRed}" Margin="0,4,0,4" TextWrapping="Wrap" />
        <TextBlock Text="{Binding SizeNote}" Style="{StaticResource Small}" TextWrapping="Wrap" />
        <CheckBox Content="If the destination is bigger, grow the last partition into the extra space" IsChecked="{Binding ExtendLast}" Margin="0,8,0,0" />
        <TextBlock Text="The disk Windows is running from can't be chosen as the destination." Style="{StaticResource Small}" Margin="0,6,0,0" />

        <Border Style="{StaticResource InfoPanel}" Margin="0,12,0,0">
            <TextBlock Text="{Binding Outcome}" TextWrapping="Wrap" />
        </Border>

        <TextBlock Margin="0,14,0,0" TextWrapping="Wrap"><Run Text="To confirm, type " /><Run Text="{Binding ExpectedConfirmation, Mode=OneWay}" FontWeight="Bold" /><Run Text=" (the destination)." /></TextBlock>
        <TextBox Text="{Binding Confirmation, UpdateSourceTrigger=PropertyChanged}" Width="200" HorizontalAlignment="Left" Margin="0,6,0,0" AutomationProperties.AutomationId="CloneConfirm" />

        <StackPanel x:Name="ProgressPanel" Visibility="Collapsed" Margin="0,14,0,0">
            <ProgressBar x:Name="Progress" Style="{StaticResource Meter}" IsIndeterminate="True" Height="6" />
            <TextBlock x:Name="ProgressText" Style="{StaticResource Small}" Margin="0,6,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <DockPanel Margin="0,16,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="CancelButton" Style="{StaticResource SecondaryButton}" Content="Cancel" IsCancel="True" Margin="0,0,8,0" />
                <Button x:Name="RunButton" Style="{StaticResource DangerButton}" Content="Clone" Click="OnRun" IsEnabled="{Binding CanRun}" AutomationProperties.AutomationId="CloneRun" />
            </StackPanel>
            <TextBlock Text="{Binding Problem}" Foreground="{DynamicResource DptAmber}" VerticalAlignment="Center" TextWrapping="Wrap" />
        </DockPanel>
    </StackPanel>
</Window>
