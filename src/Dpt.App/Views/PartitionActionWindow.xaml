<Window x:Class="Dpt.App.Views.PartitionActionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:Dpt.App.Controls"
        Title="{Binding Title}" Width="680" SizeToContent="Height" MaxHeight="820" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource DptWindow}" Foreground="{DynamicResource DptInk}"
        FontFamily="{StaticResource UiFont}" FontSize="13" AutomationProperties.AutomationId="PartitionActionWindow">
    <Window.Resources>
        <DataTemplate x:Key="Bar">
            <Border Height="30" CornerRadius="6" ClipToBounds="True" Background="{DynamicResource DptPanelSoft}">
                <ItemsControl ItemsSource="{Binding}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <c:ProportionalPanel MinItemWidth="24" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="c:ProportionalPanel.Weight" Value="{Binding Weight}" />
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{Binding BrushKey, Converter={StaticResource BrushKey}}" BorderBrush="{DynamicResource DptWindow}" BorderThickness="0,0,2,0" ToolTip="{Binding Detail}" Opacity="0.85">
                                <TextBlock Text="{Binding Label}" Foreground="White" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="5,0" />
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </DataTemplate>
    </Window.Resources>
    <StackPanel Margin="22,18">
        <TextBlock Text="{Binding Title}" Style="{StaticResource H2}" FontSize="17" />
        <TextBlock Text="{Binding Explanation}" TextWrapping="Wrap" Margin="0,6,0,12" />

        <TextBlock Text="Now" Style="{StaticResource Small}" />
        <ContentControl Content="{Binding Before}" ContentTemplate="{StaticResource Bar}" Margin="0,2,0,8" />
        <TextBlock Text="After" Style="{StaticResource Small}" />
        <ContentControl Content="{Binding After}" ContentTemplate="{StaticResource Bar}" Margin="0,2,0,14" />

        <StackPanel Visibility="{Binding ShowSize, Converter={StaticResource BoolToVisible}}" Margin="0,0,0,10">
            <DockPanel>
                <TextBlock Text="New size (MB)" Width="140" VerticalAlignment="Center" />
                <TextBox Text="{Binding SizeMb, UpdateSourceTrigger=PropertyChanged}" Width="120" HorizontalAlignment="Left" AutomationProperties.AutomationId="ActionSize" />
                <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Style="{StaticResource Small}">
                    <Run Text="between " /><Run Text="{Binding MinMb, Mode=OneWay}" /><Run Text=" and " /><Run Text="{Binding MaxMb, Mode=OneWay}" /><Run Text=" MB" />
                </TextBlock>
            </DockPanel>
            <Slider Minimum="{Binding MinMb}" Maximum="{Binding MaxMb}" Value="{Binding SizeMb}" Margin="140,6,0,0" IsSnapToTickEnabled="False" />
        </StackPanel>
        <DockPanel Margin="0,0,0,10" Visibility="{Binding ShowFileSystem, Converter={StaticResource BoolToVisible}}">
            <TextBlock Text="File system" Width="140" VerticalAlignment="Center" />
            <ComboBox ItemsSource="{Binding FileSystems}" SelectedItem="{Binding FileSystem}" Width="160" HorizontalAlignment="Left" />
        </DockPanel>
        <DockPanel Margin="0,0,0,10" Visibility="{Binding ShowLabel, Converter={StaticResource BoolToVisible}}">
            <TextBlock Text="Name (label)" Width="140" VerticalAlignment="Center" />
            <TextBox Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="ActionLabel" />
        </DockPanel>
        <DockPanel Margin="0,0,0,10" Visibility="{Binding ShowLetter, Converter={StaticResource BoolToVisible}}">
            <TextBlock Text="Drive letter" Width="140" VerticalAlignment="Center" />
            <ComboBox ItemsSource="{Binding Letters}" SelectedItem="{Binding Letter}" Width="260" HorizontalAlignment="Left" />
        </DockPanel>

        <Border Style="{StaticResource InfoPanel}" Margin="0,4,0,0">
            <StackPanel>
                <TextBlock TextWrapping="Wrap"><Run Text="Your data: " FontWeight="SemiBold" /><Run Text="{Binding DataNote, Mode=OneWay}" /></TextBlock>
                <TextBlock TextWrapping="Wrap" Margin="0,4,0,0"><Run Text="Undo: " FontWeight="SemiBold" /><Run Text="{Binding UndoNote, Mode=OneWay}" /></TextBlock>
            </StackPanel>
        </Border>

        <StackPanel Margin="0,12,0,0" Visibility="{Binding NeedsTypedConfirmation, Converter={StaticResource BoolToVisible}}">
            <TextBlock TextWrapping="Wrap"><Run Text="To confirm, type " /><Run Text="{Binding ExpectedConfirmation, Mode=OneWay}" FontWeight="Bold" /><Run Text=" below." /></TextBlock>
            <TextBox Text="{Binding Confirmation, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0" Width="240" HorizontalAlignment="Left" AutomationProperties.AutomationId="ActionConfirm" />
        </StackPanel>

        <!-- Progress -->
        <StackPanel x:Name="ProgressPanel" Visibility="Collapsed" Margin="0,14,0,0">
            <ProgressBar x:Name="Progress" Style="{StaticResource Meter}" IsIndeterminate="True" Height="6" />
            <TextBlock x:Name="ProgressText" Style="{StaticResource Small}" Margin="0,6,0,0" TextWrapping="Wrap" AutomationProperties.AutomationId="ActionProgress" />
        </StackPanel>

        <DockPanel Margin="0,16,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="CancelButton" Style="{StaticResource SecondaryButton}" Content="Cancel" IsCancel="True" Margin="0,0,8,0" />
                <Button x:Name="RunButton" Content="Make this change" Click="OnRun" IsEnabled="{Binding CanRun}" AutomationProperties.AutomationId="ActionRun">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDestructive}" Value="True">
                                    <Setter Property="Background" Value="#B84F56" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
            <TextBlock Text="{Binding Problem}" Foreground="{DynamicResource DptAmber}" VerticalAlignment="Center" TextWrapping="Wrap" />
        </DockPanel>
        <TextBlock Style="{StaticResource Small}" Margin="0,8,0,0" TextWrapping="Wrap"
                   Text="Windows will ask for administrator permission. The change is checked again right before it happens and stops if the disk is different from what's shown here." />
    </StackPanel>
</Window>
