<UserControl x:Class="Dpt.App.Views.IntegrationPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.AutomationId="IntegrationPanel">
    <Border Style="{StaticResource Card}">
        <StackPanel>
            <TextBlock Text="Windows integration" Style="{StaticResource H2}" />
            <TextBlock Text="To pin the app: open it from a permanent folder, right-click its taskbar icon, then choose Pin to taskbar. To unpin it, use the same menu." TextWrapping="Wrap" Margin="0,6,0,8" AutomationProperties.AutomationId="TaskbarGuidance" />
            <TextBlock Text="The Open folders setting below applies only when you switch it on. Switching it off restores the saved defaults. A relocated app can be registered again from its new permanent folder." TextWrapping="Wrap" Style="{StaticResource Small}" Margin="0,0,0,8" />
            <Button x:Name="RestoreButton" Content="Restore previous folder settings" HorizontalAlignment="Left" Style="{StaticResource SecondaryButton}" Click="OnRestore" AutomationProperties.AutomationId="RestoreFolderHandler" />
            <TextBlock x:Name="ResultText" TextWrapping="Wrap" Style="{StaticResource Small}" Margin="0,6,0,0" />
        </StackPanel>
    </Border>
</UserControl>
