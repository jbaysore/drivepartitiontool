<Window x:Class="Dpt.App.Views.RulePreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rule preview" Width="900" Height="640" MinWidth="620" MinHeight="400"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource DptWindow}" Foreground="{DynamicResource DptInk}"
        FontFamily="{StaticResource UiFont}" FontSize="13" AutomationProperties.AutomationId="RulePreviewWindow">
    <DockPanel Margin="20,18">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock x:Name="Heading" Style="{StaticResource H2}" FontSize="16" />
            <TextBlock x:Name="Summary" TextWrapping="Wrap" Margin="0,4,0,4" />
            <TextBlock x:Name="Totals" Style="{StaticResource Muted}" AutomationProperties.AutomationId="PreviewTotals" />
        </StackPanel>
        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Style="{StaticResource SecondaryButton}" Content="Close" IsCancel="True" Margin="0,0,8,0" />
                <Button x:Name="RunButton" Style="{StaticResource PrimaryButton}" Content="Run now" Click="OnRun" AutomationProperties.AutomationId="PreviewRun" />
            </StackPanel>
            <TextBlock Style="{StaticResource Small}" VerticalAlignment="Center" TextWrapping="Wrap"
                       Text="Nothing has changed yet. “Run now” applies exactly this list; you can undo it afterwards with Ctrl+Z." />
        </DockPanel>
        <ListView x:Name="List" Margin="0,12,0,0" BorderBrush="{DynamicResource DptBorder}" AutomationProperties.AutomationId="PreviewList">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Item" Width="230" DisplayMemberBinding="{Binding Name}" />
                    <GridViewColumn Header="From" Width="220" DisplayMemberBinding="{Binding From}" />
                    <GridViewColumn Header="To" Width="240" DisplayMemberBinding="{Binding To}" />
                    <GridViewColumn Header="Tags" Width="100" DisplayMemberBinding="{Binding Tags}" />
                    <GridViewColumn Header="Note" Width="160">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Note}" Foreground="{DynamicResource DptAmber}" TextWrapping="Wrap" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
</Window>
