<UserControl x:Class="Dpt.App.Views.SearchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Dpt.App.Controls"
             xmlns:ipc="clr-namespace:Dpt.Ipc;assembly=Dpt.Ipc"
             AutomationProperties.AutomationId="SearchView">
    <UserControl.Resources>
        <Style x:Key="ResultRow" TargetType="ListViewItem" BasedOn="{StaticResource GridRowStyle}">
            <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
            <EventSetter Event="MouseDoubleClick" Handler="OnRowDoubleClick" />
        </Style>
        <Style x:Key="Chip" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="MinWidth" Value="130" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="DisplayMemberPath" Value="Label" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="18,14,18,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Search box -->
        <Border BorderBrush="{DynamicResource DptBorder}" BorderThickness="1" CornerRadius="9" Background="{DynamicResource DptPanel}" MinHeight="44" Padding="14,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <c:Icon Data="{StaticResource Icon.Search}" Size="17" Foreground="{DynamicResource DptMuted}" />
                <TextBlock Grid.Column="1" Margin="11,0,0,0" FontSize="14" Foreground="{DynamicResource DptMuted}" VerticalAlignment="Center" IsHitTestVisible="False"
                           Text="Type any part of a name — add filters like ext:pdf, size:&gt;1gb, modified:2025"
                           Visibility="{Binding Text, ElementName=QueryBox, Converter={StaticResource NullToVisible}}" />
                <TextBox x:Name="QueryBox" Grid.Column="1" Margin="11,0,0,0" FontSize="14" Style="{StaticResource BareTextBox}" MinHeight="42"
                         Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="SearchQueryBox" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ScopeLabel}" FontSize="12" VerticalAlignment="Center" Margin="12,0,6,0" AutomationProperties.AutomationId="SearchScope" />
                    <Button Style="{StaticResource LinkButton}" Content="Search all drives" Command="{Binding ClearScopeCommand}" VerticalAlignment="Center"
                            Visibility="{Binding HasScope, Converter={StaticResource BoolToVisible}}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Filter chips -->
        <WrapPanel Grid.Row="1" Margin="0,10,0,0">
            <ComboBox Style="{StaticResource Chip}" ItemsSource="{Binding TypeOptions}" SelectedItem="{Binding TypeFilter}" AutomationProperties.AutomationId="TypeFilter" ToolTip="Type" />
            <ComboBox Style="{StaticResource Chip}" ItemsSource="{Binding SizeOptions}" SelectedItem="{Binding SizeFilter}" AutomationProperties.AutomationId="SizeFilter" ToolTip="Size" />
            <ComboBox Style="{StaticResource Chip}" ItemsSource="{Binding DateOptions}" SelectedItem="{Binding DateFilter}" AutomationProperties.AutomationId="DateFilter" ToolTip="Date modified" />
            <ComboBox Style="{StaticResource Chip}" ItemsSource="{Binding KindOptions}" SelectedItem="{Binding KindFilter}" AutomationProperties.AutomationId="KindFilter" ToolTip="Files or folders" />
            <Button Style="{StaticResource LinkButton}" Content="Clear filters" Command="{Binding ClearFiltersCommand}" VerticalAlignment="Center" Margin="4,0,16,0" />
            <Button Style="{StaticResource CommandButton}" Command="{Binding TogglePreviewCommand}" ToolTip="Preview pane (Alt+P)">
                <StackPanel Orientation="Horizontal">
                    <c:Icon Data="{StaticResource Icon.Image}" Size="15" />
                    <TextBlock Text="Preview" Margin="6,0,0,0" />
                </StackPanel>
            </Button>
        </WrapPanel>

        <Border Grid.Row="2" Style="{StaticResource InfoPanel}" Margin="0,10,0,0" Visibility="{Binding CatalogNote, Converter={StaticResource NullToCollapsed}}">
            <StackPanel Orientation="Horizontal">
                <c:Icon Data="{StaticResource Icon.Info}" Size="15" Foreground="{DynamicResource DptMuted}" Margin="0,0,8,0" />
                <TextBlock Text="{Binding CatalogNote}" Style="{StaticResource Muted}" TextWrapping="Wrap" AutomationProperties.AutomationId="CatalogNote" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="3" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ListView x:Name="Results" ItemsSource="{Binding Results}" SelectionMode="Extended" ItemContainerStyle="{StaticResource ResultRow}"
                      SelectedItem="{Binding Selected}" BorderThickness="0" Background="Transparent"
                      VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                      PreviewKeyDown="OnKeyDown" MouseRightButtonUp="OnRightClick" GridViewColumnHeader.Click="OnHeaderClick"
                      PreviewMouseLeftButtonDown="OnMouseDown" PreviewMouseMove="OnMouseMove"
                      AutomationProperties.AutomationId="SearchResults">
                <ListView.View>
                    <GridView>
                        <GridViewColumn x:Name="NameCol" Header="Name" Width="300">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="{Binding Icon}" Width="16" Height="16" Opacity="{Binding RowOpacity}" />
                                        <TextBlock Margin="7,0,0,0" Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn x:Name="LocationCol" Header="Location" Width="330">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Location}" Foreground="{DynamicResource DptMuted}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Location}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn x:Name="DriveCol" Header="Drive" Width="56" DisplayMemberBinding="{Binding Drive}" />
                        <GridViewColumn x:Name="TypeCol" Header="Type" Width="140" DisplayMemberBinding="{Binding TypeName}" />
                        <GridViewColumn x:Name="SizeCol" Header="Size" Width="100">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding SizeText}" TextAlignment="Right" MinWidth="80" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn x:Name="ModifiedCol" Header="Date modified" Width="150" DisplayMemberBinding="{Binding ModifiedText}" />
                    </GridView>
                </ListView.View>
            </ListView>

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" MaxWidth="520"
                        Visibility="{Binding ShowTips, Converter={StaticResource BoolToVisible}}">
                <TextBlock Text="Search everything on your selected drives" Style="{StaticResource H2}" HorizontalAlignment="Center" Margin="0,0,0,10" />
                <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" TextAlignment="Center"
                           Text="Type whatever you remember about the name — words can be in any order. Use the menus above, or filters such as ext:pdf, type:video, size:&gt;1gb, modified:lastmonth, in:D:\Photos, folder:." />
            </StackPanel>
            <TextBlock Text="No matches. Try fewer words or remove a filter." Style="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisible}}" AutomationProperties.AutomationId="NoResults" />

            <!-- Preview -->
            <Border Grid.Column="1" Width="300" Margin="12,0,0,0" Style="{StaticResource Card}" Padding="12"
                    Visibility="{Binding ShowPreview, Converter={StaticResource BoolToVisible}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel DataContext="{Binding Selected}">
                        <Image Source="{Binding DataContext.PreviewImage, RelativeSource={RelativeSource AncestorType=UserControl}}" MaxHeight="240" Stretch="Uniform" Margin="0,0,0,10" />
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Location}" Style="{StaticResource Small}" TextWrapping="Wrap" Margin="0,2,0,8" />
                        <TextBlock Style="{StaticResource Small}"><Run Text="{Binding TypeName, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding SizeText, Mode=OneWay}" /></TextBlock>
                        <TextBlock Style="{StaticResource Small}" Text="{Binding ModifiedText}" />
                        <TextBlock Text="{Binding DataContext.PreviewText, RelativeSource={RelativeSource AncestorType=UserControl}}" FontFamily="Cascadia Mono, Consolas"
                                   FontSize="11" TextWrapping="Wrap" Margin="0,10,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <DockPanel Grid.Row="4" Margin="0,8,0,0">
            <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="Load more" Command="{Binding LoadMoreCommand}"
                    Visibility="{Binding HasMore, Converter={StaticResource BoolToVisible}}" AutomationProperties.AutomationId="LoadMore" />
            <TextBlock Text="{Binding Summary}" Style="{StaticResource Small}" VerticalAlignment="Center" AutomationProperties.AutomationId="SearchSummary" />
        </DockPanel>
    </Grid>
</UserControl>
