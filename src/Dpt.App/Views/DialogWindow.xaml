<Window x:Class="Dpt.App.Views.DialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:Dpt.App.Controls"
        Title="{Binding Title}" SizeToContent="Height" Width="560" MaxHeight="720" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource DptWindow}" Foreground="{DynamicResource DptInk}"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        AutomationProperties.AutomationId="DialogWindow">
    <DockPanel Margin="22,20,22,18">
        <!-- Buttons -->
        <ItemsControl DockPanel.Dock="Bottom" ItemsSource="{Binding Buttons}" Margin="0,18,0,0" HorizontalAlignment="Right">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Content="{Binding Label}" Style="{Binding Style}" Margin="8,0,0,0" Click="OnButton" IsDefault="{Binding IsDefault}" IsCancel="{Binding IsCancel}"
                            AutomationProperties.AutomationId="{Binding AutomationId}" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <StackPanel DockPanel.Dock="Top">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <c:Icon Data="{Binding IconKey, Converter={StaticResource IconKey}}" Size="20" Foreground="{Binding IconBrush}" Margin="0,0,10,0" />
                <TextBlock Text="{Binding Heading}" Style="{StaticResource H2}" FontSize="16" VerticalAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>
            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,0,0,12" AutomationProperties.AutomationId="DialogMessage" />
            <TextBox x:Name="Input" Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding HasInput, Converter={StaticResource BoolToVisible}}"
                     Margin="0,0,0,8" AutomationProperties.AutomationId="DialogInput" />

            <!-- Conflict quick choices -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8" Visibility="{Binding HasChoices, Converter={StaticResource BoolToVisible}}">
                <TextBlock Text="Set all to:" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ItemsControl ItemsSource="{Binding ChoiceLabels}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource LinkButton}" Content="{Binding}" Margin="0,0,12,0" Click="OnSetAll" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </StackPanel>

        <!-- Rows (items, conflicts) -->
        <Border BorderBrush="{DynamicResource DptBorder}" BorderThickness="1" CornerRadius="7"
                Visibility="{Binding HasRows, Converter={StaticResource BoolToVisible}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="340">
                <ItemsControl ItemsSource="{Binding Rows}" AutomationProperties.AutomationId="DialogRows">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{DynamicResource DptBorder}" BorderThickness="0,0,0,1" Padding="12,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Text}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text}" />
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Small}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding Options}" SelectedIndex="{Binding Selected}" MinWidth="130" Margin="10,0,0,0"
                                              Visibility="{Binding HasOptions, Converter={StaticResource BoolToVisible}}" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
    </DockPanel>
</Window>
