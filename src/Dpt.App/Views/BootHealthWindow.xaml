<Window x:Class="Dpt.App.Views.BootHealthWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Boot health and repair" Width="950" Height="820" MinHeight="650" MinWidth="820" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource DptWindow}" Foreground="{DynamicResource DptInk}" FontFamily="{StaticResource UiFont}" FontSize="13"
        AutomationProperties.AutomationId="BootHealthWindow">
    <Grid Margin="22,18">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel>
            <DockPanel><Button Content="Refresh" Style="{StaticResource SecondaryButton}" DockPanel.Dock="Right" Click="OnRefresh" HorizontalAlignment="Right" /><TextBlock Text="Boot health" Style="{StaticResource H2}" FontSize="18" /></DockPanel>
            <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Margin="0,8,0,4" AutomationProperties.AutomationId="BootHealthSummary" />
            <ItemsControl ItemsSource="{Binding BootPartitions}">
                <ItemsControl.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Label}" /><TextBlock Text="{Binding Space}" Margin="10,0,0,0" Style="{StaticResource Small}" /></StackPanel></DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{Binding ConfigurationNote}" TextWrapping="Wrap" Margin="0,8,0,8" Style="{StaticResource Small}" AutomationProperties.AutomationId="BootConfigurationNote" />
        </StackPanel>
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <DataGrid ItemsSource="{Binding Entries}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" AutomationProperties.AutomationId="BootEntries">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Startup entry" Binding="{Binding Title}" Width="*" />
                    <DataGridTextColumn Header="What it does" Binding="{Binding Meaning}" Width="250" />
                    <DataGridTextColumn Header="Windows/boot location" Binding="{Binding Device}" Width="220" />
                </DataGrid.Columns>
            </DataGrid>
            <Expander Header="Raw Windows configuration details" Grid.Row="1" Margin="0,6,0,0" MaxHeight="180">
                <TextBox Text="{Binding RawConfiguration, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11" />
            </Expander>
        </Grid>
        <StackPanel x:Name="RepairPanel" Grid.Row="2">
            <TextBlock Text="Rebuild boot files" Style="{StaticResource H2}" />
            <TextBlock Text="Choose the Windows installation, then the partition that should start it. This helper does not diagnose or perform deeper offline recovery." TextWrapping="Wrap" Style="{StaticResource Small}" Margin="0,4,0,8" />
            <TextBlock Text="Windows installation" FontWeight="SemiBold" />
            <ComboBox ItemsSource="{Binding Sources}" SelectedItem="{Binding Source}" DisplayMemberPath="Label" Margin="0,4,0,8" AutomationProperties.AutomationId="BootRepairSource" />
            <TextBlock Text="EFI or active BIOS partition to write" FontWeight="SemiBold" />
            <ComboBox ItemsSource="{Binding BootPartitions}" SelectedItem="{Binding Destination}" DisplayMemberPath="Label" Margin="0,4,0,8" AutomationProperties.AutomationId="BootRepairDestination" />
            <TextBlock Text="{Binding Preview}" TextWrapping="Wrap" Margin="0,0,0,8" AutomationProperties.AutomationId="BootRepairPreview" />
            <StackPanel Orientation="Horizontal">
                <TextBlock VerticalAlignment="Center"><Run Text="To write boot files, type " /><Run Text="{Binding ExpectedConfirmation, Mode=OneWay}" FontWeight="Bold" /></TextBlock>
                <TextBox Text="{Binding Confirmation, UpdateSourceTrigger=PropertyChanged}" Width="150" Margin="10,0,0,0" AutomationProperties.AutomationId="BootRepairConfirm" />
            </StackPanel>
            <TextBlock Text="{Binding Problem}" Foreground="{DynamicResource DptAmber}" TextWrapping="Wrap" Margin="0,6,0,0" AutomationProperties.AutomationId="BootRepairProblem" />
        </StackPanel>
        <DockPanel Grid.Row="3" Margin="0,14,0,0">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Button x:Name="CloseButton" Content="Close" IsCancel="True" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" />
                <Button x:Name="RunButton" Content="Rebuild boot files" IsEnabled="{Binding CanRun}" Style="{StaticResource DangerButton}" Click="OnRun" AutomationProperties.AutomationId="BootRepairRun" />
            </StackPanel>
            <TextBlock x:Name="ResultText" TextWrapping="Wrap" Margin="0,0,10,0" AutomationProperties.AutomationId="BootRepairResult" />
        </DockPanel>
    </Grid>
</Window>
