<Application x:Class="Dpt.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:i="clr-namespace:Dpt.App.Infrastructure"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Palette (Light/Dark) is inserted at index 0 by ThemeService. -->
                <ResourceDictionary Source="Themes/Icons.xaml" />
                <ResourceDictionary Source="Themes/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <i:BoolToVisibilityConverter x:Key="BoolToVisible" />
            <i:BoolToVisibilityConverter x:Key="BoolToCollapsed" Invert="True" />
            <i:NullToVisibilityConverter x:Key="NullToCollapsed" />
            <i:NullToVisibilityConverter x:Key="NullToVisible" Invert="True" />
            <i:IconKeyConverter x:Key="IconKey" />
            <i:EqualsConverter x:Key="Equals" />
            <i:PathEqualsMultiConverter x:Key="PathEquals" />
            <i:FractionToGridLengthConverter x:Key="FractionStar" />
            <i:FractionToGridLengthConverter x:Key="RemainderStar" Remainder="True" />
            <i:UsageBrushConverter x:Key="UsageBrush" />
            <i:InverseBoolConverter x:Key="InverseBool" />
            <i:BrushKeyConverter x:Key="BrushKey" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
