<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>DrivePartitionTool.CatalogService</AssemblyName>
    <RootNamespace>Dpt.IndexService</RootNamespace>
    <!-- Lower priority than interactive work. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Dpt.Index\Dpt.Index.csproj" />
    <ProjectReference Include="..\Dpt.Ipc\Dpt.Ipc.csproj" />
  </ItemGroup>
</Project>
